  dialogues:
  - id: dlg_ava_meet
    startNodeId: n_start
    nodes:
    - id: n_start
      speakerId: char_demo
      text: 'Oh... hola. ¿Tú eres el nuevo inquilino del piso de al lado?'
      options:
      - id: opt_hello
        text: 'Sí, encantado. ¿Me recomendaste tú el piso?'
        nextNodeId: n_positive
