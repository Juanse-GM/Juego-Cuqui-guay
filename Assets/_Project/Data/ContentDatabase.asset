        conditions: []
        effects:
        - type: 3
          key: char_demo
          value: -5
          stat: 0
    - id: n_positive
      speakerId: char_demo
      text: 'Jeje, tal vez. Nos veremos por aquí, entonces.'
      options: []
    - id: n_negative
      speakerId: char_demo
      text: 'Ah... perdona, me he confundido de persona.'
